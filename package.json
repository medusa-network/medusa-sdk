{
  "name": "@medusa-network/medusa-sdk",
  "version": "0.1.0-rc3",
  "description": "The Typescript library for developers to use with Medusa-enabled applications",
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "main": "lib/src/index.js",
  "types": "lib/src/index.d.ts",
  "files": ["/lib"],
  "scripts": {
    "test:contracts": "cd contracts && forge clean && forge install && forge build --skip test --skip script",
    "build:contracts": "cd contracts && forge clean && forge install && forge build --skip test --skip script",
    "build:typechain": "rm -rf typechain && typechain --target ethers-v6 --out-dir typechain 'contracts/out/Playground.sol/Playground.json' 'contracts/out/*.sol/*.json'",
    "build:bindings": "npm run build:contracts && npm run build:typechain",
    "build": "npm run build:bindings && tsc -p tsconfig.build.json",
    "lint": "rome ci src/**",
    "test": "npm run test:contracts && npm run build:typechain && hardhat test",
    "prepack": "npm run build:bindings && npm run build"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [],
  "author": "Medusa Community <info@medusanet.xyz>",
  "license": "MIT AND Apache-2.0",
  "dependencies": {
    "ffjavascript": "^0.2.63",
    "hardhat": "^2.20.1",
    "js-crypto-hkdf": "^1.0.5",
    "minimatch": "^9.0.3",
    "neverthrow": "^6.1.0",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@ethersproject/abi": "^5.7.0",
    "@ethersproject/providers": "^5.7.2",
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.0",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.10",
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@nomicfoundation/hardhat-ethers": "^3.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.0",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.11",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.19",
    "@typescript-eslint/eslint-plugin": "^7.0.1",
    "@typescript-eslint/parser": "^7.0.1",
    "chai": "^4.4.1",
    "dotenv": "^16.4.4",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-promise": "^6.1.1",
    "ethers": "^6.11.1",
    "fast-sha256": "^1.3.0",
    "hardhat-gas-reporter": "^1.0.10",
    "prettier": "^3.2.5",
    "rome": "^12.1.3",
    "solidity-coverage": "^0.8.7",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.3.3"
  }
}
