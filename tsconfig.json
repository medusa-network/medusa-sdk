{
  "compilerOptions": {
    "target": "es2022",
    "module": "node16",
    "lib": [
      "es2023",
      "dom"
    ],
    "strict": false,
    "esModuleInterop": true,
    "outDir": "lib",
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": true,
    "moduleResolution": "node16",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noImplicitAny": false,
    "noImplicitThis": false
  },
  "include": [
    "./src/**/*",
    "./typechain",
    "./scripts",
    "./test",
    "./hardhat.config.ts"
  ]
}